run = "bash -lc '{ npm ls -g @atbash/cli@0.7.4 >/dev/null 2>&1 || npm install -g --ignore-scripts @atbash/cli@0.7.4; } && umask 077 && mkdir -p ~/.config/atbash && chmod 700 ~/.config/atbash && find ~/.config/atbash -type f -exec chmod 600 {} + && atbash --version && bash -i'"
entrypoint = "README.md"

[nix]
channel = "stable-24_05"

[env]
PATH = "/home/runner/.npm-global/bin:/home/runner/$REPL_SLUG/.config/atbash:$PATH"

[gitHubImport]
requiredFiles = [".replit", "replit/replit.nix"]

[unitTest]
language = "bash"

[deployment]
deploymentTarget = "static"
